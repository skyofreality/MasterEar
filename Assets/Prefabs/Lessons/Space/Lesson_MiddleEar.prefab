  m_Name: 
  m_EditorClassIdentifier: 
  data:
    name: 'Promontory '
    detail: 'The promontory is a rounded bulge on the medial (labyrinthine) wall
      of the middle ear, produced by the first (basal) turn of the cochlea lying
      beneath it.

      It lies between the oval window (above and posteriorly)
      and the round window (below and posteriorly).'
  originalLocalPosition: {x: 0, y: 0, z: 0}
  originalLocalEulerAngles: {x: 0, y: 0, z: 0}
