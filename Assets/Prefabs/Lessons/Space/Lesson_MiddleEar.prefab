  m_Name: 
  m_EditorClassIdentifier: 
  data:
    name: 'Internal Jugular vein '
    detail: 'The Internal Jugular Vein (IJV) lies just below the floor (jugular wall)
      of the middle ear cavity, separated by a thin bony plate that forms the jugular
      fossa.

      This wall is known as the floor or jugular wall of the tympanic
      cavity.'
  originalLocalPosition: {x: 0, y: 0, z: 0}
