  m_Name: 
  m_EditorClassIdentifier: 
  data:
    name: 'Auditory/ Eustachian tube '
    detail: 'The auditory tube (Eustachian tube) is a narrow canal that connects
      the anterior wall of the middle ear (tympanic cavity) to the nasopharynx.

      Its
      main function is to equalize air pressure on both sides of the tympanic membrane
      and to drain mucus from the middle ear into the nasopharynx.'
